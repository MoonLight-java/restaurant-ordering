/* ============================================
   Profile Page — Sunset Bistro
   ============================================ */

.page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* Hero */
.profile-hero {
  position: relative;
  background: linear-gradient(160deg, #1E272E 0%, #2D3436 40%, #3D2C2E 100%);
  padding: 64rpx 32rpx 40rpx;
  overflow: hidden;
}

.hero-bg-pattern {
  position: absolute;
  inset: 0;
  opacity: 0.06;
  background:
    radial-gradient(circle at 20% 30%, #FF6B35 40rpx, transparent 40rpx),
    radial-gradient(circle at 80% 70%, #FF8C5A 60rpx, transparent 60rpx),
    radial-gradient(circle at 50% 50%, #FDCB6E 30rpx, transparent 30rpx);
}

.hero-content {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.avatar-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 20rpx;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
}

.avatar-ring {
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.2);
}

.nickname {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 6rpx;
}

.phone-hint {
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  margin-bottom: 12rpx;
}

.edit-badge {
  background: rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
  padding: 8rpx 28rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(255,255,255,0.15);
}

/* Stats */
.stats-row {
  background: #fff;
  margin: -24rpx 24rpx 20rpx;
  border-radius: var(--radius-md);
  padding: 28rpx 16rpx;
  display: flex;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 2;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 800;
}

.stat-num.pending { color: #E17055; }
.stat-num.preparing { color: #6C5CE7; }
.stat-num.completed { color: #00B894; }

.stat-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.stat-divider {
  width: 1rpx;
  background: #F0F2F5;
  margin: 8rpx 0;
}

/* Menu card */
.menu-card {
  background: #fff;
  margin: 0 24rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  transition: background 0.15s ease;
}

.menu-item:not(:last-child) {
  border-bottom: 1rpx solid #F8F9FA;
}

.menu-item:active {
  background: #F8F9FA;
}

.menu-icon-wrap {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.menu-icon-wrap.orders { background: #FFF0EB; }
.menu-icon-wrap.address { background: #F0EDFF; }
.menu-icon-wrap.about { background: #E6FFF8; }

.menu-emoji {
  font-size: 28rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-badge {
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  padding: 0 8rpx;
}

.menu-arrow {
  font-size: 32rpx;
  color: #DFE6E9;
  font-weight: 300;
}
