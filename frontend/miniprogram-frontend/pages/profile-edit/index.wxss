/* ============================================
   Profile Edit — Sunset Bistro
   ============================================ */

.page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* Avatar */
.avatar-section {
  background: linear-gradient(160deg, #1E272E 0%, #2D3436 40%, #3D2C2E 100%);
  padding: 56rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.25);
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s ease;
}

.avatar-wrap:active .avatar-overlay {
  opacity: 1;
}

.camera-icon {
  font-size: 40rpx;
}

.avatar-hint {
  font-size: 24rpx;
  color: rgba(255,255,255,0.65);
}

/* Form */
.form-card {
  background: #fff;
  margin: 20rpx 24rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
}

.form-item:not(:last-child) {
  border-bottom: 1rpx solid #F5F6FA;
}

.form-label {
  width: 130rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  text-align: right;
}

.form-input::placeholder {
  color: #DFE6E9;
}

/* Gender */
.gender-group {
  display: flex;
  gap: 14rpx;
  flex: 1;
  justify-content: flex-end;
}

.gender-option {
  padding: 12rpx 28rpx;
  border-radius: var(--radius-sm);
  background: #F5F6FA;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.gender-option.active {
  background: #FFF5F0;
  color: var(--primary);
  border-color: var(--primary);
  font-weight: 600;
}

/* Button */
.btn-section {
  padding: 32rpx 24rpx;
}

.save-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: var(--radius-xl);
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 53, 0.3);
  transition: all 0.2s ease;
}

.save-btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}
