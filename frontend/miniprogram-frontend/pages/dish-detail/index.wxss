/* ============================================
   Dish Detail — Sunset Bistro
   ============================================ */

.page {
  background: var(--bg-page);
  min-height: 100vh;
  padding-bottom: 140rpx;
}

/* Hero image */
.hero-wrap {
  width: 100%;
  height: 480rpx;
  position: relative;
  overflow: hidden;
}

.hero-image {
  width: 100%;
  height: 100%;
}

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    transparent 40%,
    rgba(0,0,0,0.15) 70%,
    rgba(0,0,0,0.7) 100%
  );
}

.hero-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 28rpx;
}

.hero-name {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.hero-price {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--accent-gold);
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

/* Info card */
.info-card {
  background: #fff;
  margin: 20rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.info-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 14rpx;
}

.label-icon {
  font-size: 30rpx;
}

.info-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.7;
}

/* Spec card */
.spec-card {
  background: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.spec-group {
  margin-bottom: 24rpx;
}

.spec-group:last-child {
  margin-bottom: 0;
}

.spec-group-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 600;
  margin-bottom: 16rpx;
  padding-left: 4rpx;
}

.spec-items {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.spec-item {
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
  border-radius: var(--radius-sm);
  background: #F5F6FA;
  font-size: 26rpx;
  color: var(--text-secondary);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.spec-item.active {
  background: linear-gradient(135deg, #FFF5F0, #FFEBE0);
  border-color: var(--primary);
  color: var(--primary);
  font-weight: 600;
  box-shadow: 0 2rpx 12rpx rgba(255, 107, 53, 0.12);
}

.spec-item-name {
  margin-right: 8rpx;
}

.spec-item-price {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 500;
}

/* Bottom spacer */
.bottom-spacer {
  height: 40rpx;
}

/* Bottom bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  z-index: 100;
  gap: 16rpx;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #F5F6FA;
  border-radius: var(--radius-full);
  padding: 4rpx;
}

.qty-btn {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  transition: all 0.15s ease;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.06);
}

.qty-btn:active {
  transform: scale(0.92);
}

.qty-btn.disabled {
  opacity: 0.35;
}

.qty-icon {
  font-size: 32rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.qty-num {
  width: 64rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.price-area {
  flex: 1;
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 6rpx;
}

.total-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.total-price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--primary);
}

.add-cart-btn {
  background: linear-gradient(135deg, var(--primary), #FF8C5A);
  color: #fff;
  padding: 20rpx 36rpx;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.3);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.add-cart-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
