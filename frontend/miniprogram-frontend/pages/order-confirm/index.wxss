/* ============================================
   Order Confirm — Sunset Bistro
   ============================================ */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 140rpx;
}

/* Section card overrides */
.section-card {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

/* Address card */
.address-card {
  margin-top: 20rpx;
}

.addr-icon-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.addr-pin {
  font-size: 30rpx;
}

.addr-section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.addr-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.addr-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.addr-phone {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.addr-full {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.5;
}

.no-address {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--primary);
  font-size: 30rpx;
  font-weight: 500;
}

.arrow-icon {
  font-size: 36rpx;
  color: var(--text-tertiary);
}

/* Section header */
.section-header-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.section-icon {
  font-size: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* Order items */
.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.order-item:not(:last-child) {
  border-bottom: 1rpx solid #F8F9FA;
}

.oi-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-sm);
  background: #F5F6FA;
}

.oi-info {
  flex: 1;
  padding: 0 16rpx;
}

.oi-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.oi-spec {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  display: block;
}

.oi-right {
  text-align: right;
  flex-shrink: 0;
}

.oi-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  display: block;
}

.oi-qty {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

/* Remark */
.remark-input {
  width: 100%;
  height: 120rpx;
  background: #F5F6FA;
  border-radius: var(--radius-sm);
  padding: 16rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  box-sizing: border-box;
}

/* Bottom bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  z-index: 100;
  gap: 20rpx;
}

.total-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  white-space: nowrap;
}

.total-label {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.total-price {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--primary);
}

.submit-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border: none;
  padding: 22rpx 48rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.3);
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.submit-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}
