/* ============================================
   Address List — Sunset Bistro
   ============================================ */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 140rpx;
}

/* Address card */
.address-list {
  padding: 16rpx 20rpx;
}

.address-card {
  background: #fff;
  margin-bottom: 14rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.card-contact {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.contact-name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.contact-phone {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.default-tag {
  background: #FFF5F0;
  color: var(--primary);
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
}

.card-addr {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.6;
  display: block;
  margin-bottom: 14rpx;
}

.card-footer {
  display: flex;
  gap: 32rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid #F5F6FA;
}

.action-link {
  font-size: 26rpx;
  font-weight: 500;
}

.action-link.edit { color: var(--primary); }
.action-link.delete { color: #E17055; }

/* Bottom add button */
.bottom-btn-wrap {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0,0,0,0.06);
  z-index: 100;
}

.add-btn {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 700;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  letter-spacing: 1rpx;
  box-shadow: 0 6rpx 24rpx rgba(255, 107, 53, 0.3);
}

.add-icon {
  font-size: 36rpx;
  font-weight: 300;
}
