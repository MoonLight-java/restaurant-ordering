<view class="page" wx:if="{{order}}">
  <!-- Status Banner -->
  <view class="status-hero status-{{order.status}}">
    <view class="status-pattern"></view>
    <view class="status-content">
      <view class="status-icon-circle">
        <text wx:if="{{order.status === 0}}">🕐</text>
        <text wx:elif="{{order.status === 1}}">✅</text>
        <text wx:elif="{{order.status === 2}}">🔥</text>
        <text wx:elif="{{order.status === 3}}">🎉</text>
        <text wx:else>❌</text>
      </view>
      <text class="status-title">{{statusText}}</text>
      <text class="status-hint" wx:if="{{order.status === 0}}">请尽快完成支付</text>
      <text class="status-hint" wx:elif="{{order.status === 1}}">商家已确认，正在准备</text>
      <text class="status-hint" wx:elif="{{order.status === 2}}">美味正在制作中</text>
      <text class="status-hint" wx:elif="{{order.status === 3}}">订单已完成，期待再次光临</text>
      <text class="status-hint" wx:elif="{{order.status === 4}}">订单已取消</text>
    </view>
  </view>

  <!-- Delivery Address -->
  <view class="section-card" wx:if="{{address}}">
    <view class="section-head">
      <text class="section-dot">📍</text>
      <text class="section-label">收货地址</text>
    </view>
    <view class="addr-body">
      <view class="addr-line1">
        <text class="addr-name">{{address.receiverName}}</text>
        <text class="addr-phone">{{address.receiverPhone}}</text>
      </view>
      <text class="addr-line2">{{address.province}}{{address.city}}{{address.district}} {{address.detailAddress}}</text>
    </view>
  </view>

  <!-- Order Info -->
  <view class="section-card">
    <view class="section-head">
      <text class="section-dot">📋</text>
      <text class="section-label">订单信息</text>
    </view>
    <view class="info-grid">
      <view class="info-row">
        <text class="info-key">订单编号</text>
        <text class="info-val mono">{{order.orderNo}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">下单时间</text>
        <text class="info-val">{{order.createTime}}</text>
      </view>
      <view class="info-row">
        <text class="info-key">订单状态</text>
        <text class="info-val status-color-{{order.status}}">{{statusText}}</text>
      </view>
      <view class="info-row" wx:if="{{order.payTime}}">
        <text class="info-key">支付时间</text>
        <text class="info-val">{{order.payTime}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-key">备注</text>
        <text class="info-val remark">{{order.remark}}</text>
      </view>
    </view>
  </view>

  <!-- Dishes -->
  <view class="section-card">
    <view class="section-head">
      <text class="section-dot">🍽️</text>
      <text class="section-label">菜品明细</text>
    </view>
    <view class="dish-item" wx:for="{{items}}" wx:key="id">
      <image class="dish-img" src="{{item.dishImage || '/images/default-dish.png'}}" mode="aspectFill" />
      <view class="dish-info">
        <text class="dish-name">{{item.dishName}}</text>
        <text class="dish-spec" wx:if="{{item.specs || item.specJson}}">{{item.specs || formatSpec(item.specJson)}}</text>
      </view>
      <view class="dish-meta">
        <text class="dish-price">¥{{item.unitPrice}}</text>
        <text class="dish-qty">x{{item.quantity}}</text>
      </view>
    </view>
  </view>

  <!-- Price -->
  <view class="section-card">
    <view class="section-head">
      <text class="section-dot">💰</text>
      <text class="section-label">价格明细</text>
    </view>
    <view class="price-list">
      <view class="price-row">
        <text class="pr-label">商品总额</text>
        <text class="pr-value">¥{{order.totalAmount || '0.00'}}</text>
      </view>
      <view class="price-row" wx:if="{{order.discountAmount > 0}}">
        <text class="pr-label">优惠减免</text>
        <text class="pr-value discount">-¥{{order.discountAmount}}</text>
      </view>
      <view class="price-row" wx:if="{{order.deliveryFee > 0}}">
        <text class="pr-label">配送费</text>
        <text class="pr-value">¥{{order.deliveryFee}}</text>
      </view>
      <view class="price-row total-row">
        <text class="pr-label pr-total-label">实付金额</text>
        <text class="pr-value pr-total-value">¥{{order.payAmount}}</text>
      </view>
    </view>
  </view>

  <view class="actions-spacer"></view>

  <!-- Bottom Actions -->
  <view class="bottom-actions">
    <block wx:if="{{order.status === 0}}">
      <view class="action-btn outline" bindtap="cancelOrder">取消订单</view>
      <view class="action-btn primary" bindtap="payOrder">去支付 ¥{{order.payAmount}}</view>
    </block>
    <block wx:elif="{{order.status === 1}}">
      <view class="action-btn outline" bindtap="cancelOrder">取消订单</view>
    </block>
    <block wx:elif="{{order.status === 3}}">
      <view class="action-btn primary full" bindtap="reOrder">再来一单</view>
    </block>
  </view>
</view>

<view class="loading-page" wx:if="{{!order && loading}}">
  <text>加载中...</text>
</view>
