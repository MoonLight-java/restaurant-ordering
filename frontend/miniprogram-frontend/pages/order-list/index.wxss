/* ============================================
   Order List — Sunset Bistro
   ============================================ */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 40rpx;
}

/* Tabs */
.tabs-wrap {
  background: #fff;
  padding-top: 8rpx;
  position: sticky;
  top: 0;
  z-index: 50;
  box-shadow: var(--shadow-sm);
}

.tabs {
  white-space: nowrap;
  padding: 0 16rpx;
}

.tab-item {
  display: inline-block;
  position: relative;
  padding: 24rpx 32rpx 20rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  font-weight: 500;
  transition: color 0.25s ease;
}

.tab-item.active {
  color: var(--primary);
  font-weight: 700;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 5rpx;
  background: linear-gradient(90deg, var(--primary), var(--primary-light));
  border-radius: 3rpx;
}

/* Order list */
.order-list {
  padding: 16rpx 20rpx;
}

/* Order card */
.order-card {
  background: #fff;
  border-radius: var(--radius-md);
  margin-bottom: 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s ease;
}

.order-card:active {
  transform: scale(0.99);
}

/* Card header */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #F5F6FA;
}

.order-no {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-family: monospace;
}

.status-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.status-0 {
  color: #E17055;
  background: #FFF0EB;
}

.status-1 {
  color: #00B894;
  background: #E6FFF8;
}

.status-2 {
  color: #6C5CE7;
  background: #F0EDFF;
}

.status-3 {
  color: #636E72;
  background: #F5F6FA;
}

.status-4 {
  color: #B2BEC3;
  background: #F5F6FA;
}

/* Card items */
.card-items {
  margin-bottom: 12rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.oi-img {
  width: 76rpx;
  height: 76rpx;
  border-radius: var(--radius-sm);
  margin-right: 14rpx;
  background: #F5F6FA;
}

.oi-info {
  flex: 1;
  overflow: hidden;
}

.oi-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.oi-specs {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 2rpx;
}

.oi-meta {
  text-align: right;
  flex-shrink: 0;
  margin-left: 12rpx;
}

.oi-price {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  display: block;
}

.oi-qty {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 2rpx;
}

/* Card footer */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 14rpx;
  border-top: 1rpx solid #F5F6FA;
}

.card-time {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.card-summary {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.item-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.amount-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.amount-value {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--primary);
}

/* Card actions */
.card-actions {
  display: flex;
  justify-content: flex-end;
  gap: 14rpx;
  padding-top: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  font-weight: 600;
  padding: 10rpx 28rpx;
  border-radius: var(--radius-full);
  transition: all 0.15s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.primary {
  background: linear-gradient(135deg, var(--primary), var(--primary-light));
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.2);
}

.action-btn.outline {
  background: #fff;
  color: var(--text-secondary);
  border: 1rpx solid #DFE6E9;
}

/* Load more */
.load-more {
  text-align: center;
  padding: 28rpx;
  font-size: 26rpx;
  color: var(--text-tertiary);
}

/* Button overrides */
.btn-outline {
  background: #fff;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-xl);
  font-size: 28rpx;
  font-weight: 500;
  padding: 16rpx 40rpx;
}
